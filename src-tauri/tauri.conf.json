{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Feather MD",
  "version": "1.10.7",
  "identifier": "com.fmrdigital.feathermd",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Feather MD",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: http://asset.localhost https: data:; connect-src 'self' https://forgejo.familytechlab.com https://feather-md-analytics-production.up.railway.app https://discord.com https://discordapp.com https://thread.fmrdigital.dev",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "FMR Digital LLC",
    "copyright": "© 2026 FMR Digital LLC",
    "homepage": "https://fmrdigital.dev",
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "description": "Markdown file"
      }
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "quiet"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4NTg1NzQyQ0FCNkQwNUUKUldSZTBMYktRbGRZdUdVamo5TnlHUjN6L1JoUEFsUE8wUnpHY2pQcllrQUErQlNPRTl3VDRpaUcK",
      "endpoints": [
        "https://forgejo.familytechlab.com/frank/featherMD-releases/releases/download/latest/latest.json"
      ]
    }
  }
}
